# Loaded only by `npm run dev`. In dev, "/api/v1" is relative and the vite
# proxy (vite.config.js) forwards it to VITE_PROXY_TARGET so the httpOnly
# refresh cookie stays same-origin.
VITE_API_URL=/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/ws
VITE_PROXY_TARGET=http://127.0.0.1:8000

VITE_IDLE_TIMEOUT_MIN=25
VITE_IDLE_WARNING_MIN=24
