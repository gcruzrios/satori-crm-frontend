# Base URL of the Satori CRM API (REST). In dev, "/api/v1" is proxied to VITE_PROXY_TARGET
# by vite.config.js so the httpOnly refresh cookie stays same-origin.
VITE_API_URL=/api/v1

# WebSocket endpoint for real-time notifications / communications (spec §12).
VITE_WS_URL=ws://127.0.0.1:8000/ws

# Only used by the vite dev-server proxy.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Idle auto-logout (spec §2). Minutes.
VITE_IDLE_TIMEOUT_MIN=25
VITE_IDLE_WARNING_MIN=24
