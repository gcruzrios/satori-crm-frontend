# Environment variables. Vite loads them per mode:
#   npm run dev   -> .env + .env.development  (+ .env.local overrides)
#   npm run build -> .env + .env.production   (+ .env.local overrides)
# All VITE_* values are PUBLIC (they end up in the JS bundle). Never put a
# secret here. .env.development / .env.production are committed; use
# .env.local for machine-specific overrides.

# --- Development (see .env.development) ---
# "/api/v1" is relative so the vite dev proxy keeps the httpOnly refresh
# cookie same-origin.
VITE_API_URL=/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/ws
VITE_PROXY_TARGET=http://127.0.0.1:8000

# --- Production (see .env.production) ---
# VITE_API_URL=https://satori-crm-api-6f86325efbae.herokuapp.com/api/v1
# VITE_WS_URL=wss://satori-crm-api-6f86325efbae.herokuapp.com/ws

# Idle auto-logout (spec §2), in minutes.
VITE_IDLE_TIMEOUT_MIN=25
VITE_IDLE_WARNING_MIN=24
